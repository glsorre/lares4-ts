{
  "name": "lares4-ts",
  "version": "0.2.0-beta.0",
  "description": "A ts lib to connect and pilot Ksenia Lares 4 smart home pheriperals",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/index-browser.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index-browser.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "author": "Giuseppe Lucio Sorrentino",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/glsorre/lares4-ts"
  },
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "eslint": "^9.16.0",
    "terser": "^5.36.0",
    "tsx": "^4.20.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0"
  },
  "dependencies": {
    "bufferutil": "^4.0.8",
    "winston": "^3.17.0",
    "ws": "^8.18.0"
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "lint": "eslint . --max-warnings=0",
    "naming:check": "node ./scripts/check-filenames.mjs",
    "boundaries:check": "node ./scripts/check-module-boundaries.mjs",
    "api:check": "node ./scripts/check-api-surface.mjs",
    "api:update": "node ./scripts/check-api-surface.mjs --update",
    "test:build": "tsc -p tsconfig.test.json --noEmit",
    "test:run": "tsx --test tests/*.test.ts tests/lib/core/*.test.ts tests/lib/public/*.test.ts tests/lib/internal/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage tests/*.test.ts tests/lib/core/*.test.ts tests/lib/public/*.test.ts tests/lib/internal/*.test.ts",
    "test:coverage:ci": "npm run test:build && mkdir -p coverage && tsx --test --experimental-test-coverage --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage/lcov.info tests/*.test.ts tests/lib/core/*.test.ts tests/lib/public/*.test.ts tests/lib/internal/*.test.ts",
    "test": "npm run test:build && npm run test:run",
    "prepublishOnly": "npm run lint && npm run build",
    "example": "tsx examples/list-and-watch.ts",
    "debug:console": "tsx examples/debug-console-tui.ts"
  }
}